/* =========================================================
   STM PROJECT — SELECTED INSTAGRAM REELS
   ========================================================= */

.project-reels {
  margin-top: 72px;
  padding-top: 36px;
  border-top: 1px solid var(--line);
}

.project-reels-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 32px;
  margin-bottom: 28px;
}

.project-reels-heading > div > span {
  display: block;
  margin-bottom: 8px;

  font: 10px var(--mono);
  letter-spacing: .16em;
  text-transform: uppercase;

  color: var(--ink-soft);
}

.project-reels-heading h3 {
  margin: 0;

  font-size: clamp(28px, 4vw, 52px);
  line-height: .95;
  letter-spacing: -.04em;
  font-weight: 500;
}

.project-reels-heading p {
  max-width: 320px;
  margin: 0;

  font-size: 12px;
  line-height: 1.5;

  color: var(--ink-soft);
}


/* =========================================================
   REEL GRID
   ========================================================= */

.project-reels-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;
}


/* =========================================================
   REEL CARD
   ========================================================= */

.project-reel-card {
  display: block;

  color: inherit;
  text-decoration: none;

  cursor: pointer;
}

.project-reel-image {
  position: relative;

  width: 100%;

  aspect-ratio: 9 / 16;

  overflow: hidden;

  background: var(--paper);
}

.project-reel-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  filter: saturate(.82);

  transition:
    transform .5s var(--ease-out),
    filter .5s var(--ease-out);
}


/* =========================================================
   IMAGE HOVER
   ========================================================= */

.project-reel-card:hover .project-reel-image img {
  transform: scale(1.045);

  filter: saturate(1);
}


/* =========================================================
   WATCH REEL LABEL
   ========================================================= */

.project-reel-open {
  position: absolute;

  left: 12px;
  bottom: 12px;

  display: inline-flex;

  align-items: center;

  gap: 6px;

  padding: 8px 10px;

  background: var(--cream);

  color: var(--charcoal);

  font: 9px var(--mono);

  letter-spacing: .1em;

  text-transform: uppercase;

  opacity: 0;

  transform: translateY(6px);

  transition:
    opacity .25s ease,
    transform .25s var(--ease-out);
}

.project-reel-card:hover .project-reel-open {
  opacity: 1;

  transform: translateY(0);
}


/* =========================================================
   REEL NUMBER
   ========================================================= */

.project-reel-number {
  position: absolute;

  top: 12px;
  right: 12px;

  width: 30px;
  height: 30px;

  display: grid;

  place-items: center;

  border: 1px solid rgba(252,249,242,.7);

  color: var(--cream);

  background: rgba(51,45,45,.35);

  backdrop-filter: blur(5px);

  font: 9px var(--mono);

  letter-spacing: .08em;
}


/* =========================================================
   REEL META
   ========================================================= */

.project-reel-meta {
  display: flex;

  justify-content: space-between;

  gap: 12px;

  padding-top: 10px;

  font: 9px var(--mono);

  letter-spacing: .1em;

  text-transform: uppercase;
}

.project-reel-meta span:last-child {
  opacity: .45;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

  .project-reels {
    margin-top: 48px;

    padding-top: 28px;
  }

  .project-reels-heading {
    display: block;

    margin-bottom: 20px;
  }

  .project-reels-heading p {
    margin-top: 14px;

    max-width: 100%;
  }

  .project-reels-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 10px;
  }

  .project-reel-open {
    opacity: 1;

    transform: none;

    font-size: 8px;

    padding: 7px 8px;
  }

  .project-reel-meta {
    display: block;

    line-height: 1.5;
  }

  .project-reel-meta span {
    display: block;
  }

  .project-reel-meta span:last-child {
    margin-top: 3px;
  }
}

/* =========================================================
   ABOUT CARD — FINAL LOGO LAYOUT
   ========================================================= */

.about-visual {
  position: relative;
  overflow: hidden;
}

/* LOGO + PLUS ROW */
.about-logo-plus {
  position: absolute !important;

  top: 50% !important;
  left: 50% !important;

  transform: translate(-50%, -50%) !important;

  width: 92% !important;

  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: center !important;

  gap: 20px !important;

  z-index: 10 !important;
}

/* LOGO */
.about-logo-plus .about-logo {
  position: relative !important;

  left: auto !important;
  top: auto !important;

  display: block !important;

  width: 280px !important;
  height: 150px !important;

  object-fit: contain !important;
  object-position: center !important;

  filter: brightness(0) invert(1) !important;

  transform: scale(2.2) !important;
  transform-origin: center !important;

  flex: 0 1 auto !important;

  z-index: 11 !important;
}

/* PLUS */
.about-logo-plus i {
  position: relative !important;

  left: auto !important;
  top: auto !important;

  display: block !important;

  margin: 0 !important;

  color: var(--cream) !important;

  font-family: var(--sans) !important;
  font-size: 54px !important;
  font-weight: 300 !important;

  line-height: 1 !important;
  font-style: normal !important;

  flex: 0 0 auto !important;

  z-index: 12 !important;
}

/* BOTTOM LABEL */
.about-visual > small {
  position: absolute !important;

  left: 12px !important;
  bottom: 12px !important;

  z-index: 20 !important;
}

.feed-post {
  overflow: hidden;
}

.feed-post img {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  z-index: 0;

  transition:
    transform 0.5s var(--ease-out),
    filter 0.5s var(--ease-out);
}

.feed-post::after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      to bottom,
      transparent 55%,
      rgba(252, 249, 242, 0.92) 100%
    );

  z-index: 1;

  pointer-events: none;
}

.feed-post span,
.feed-post i,
.feed-post em {
  position: absolute;
  z-index: 3;
}

.feed-post:hover img {
  transform: scale(1.06);
}

.feed-post:hover {
  z-index: 20;
}
/* =====================================================
   INSTAGRAM PHONE — REAL SCREEN IMAGE
   ===================================================== */

.instagram-device {
  overflow: hidden;
}

.device-screen {
  position: relative;
  overflow: hidden;
  height: 100%;
  padding: 0 !important;
  background: var(--cream);
}

.device-screen-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  z-index: 0;
}

.device-screen::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      to bottom,
      rgba(51, 45, 45, 0.15) 0%,
      transparent 35%,
      rgba(51, 45, 45, 0.35) 100%
    );
  z-index: 1;
  pointer-events: none;
}

.device-screen-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  padding: 21px 7px 7px;
  display: flex;
  flex-direction: column;
  gap: 7px;
  color: var(--cream);
  pointer-events: none;
}

.device-screen-overlay span {
  font: 6px var(--mono);
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
}

.device-screen-overlay strong {
  margin-top: auto;
  font-size: 15px;
  line-height: 0.88;
  letter-spacing: -0.07em;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.55);
}

.device-screen-overlay small {
  font: 6px var(--mono);
  color: var(--cream);
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
}
/* ============================================================
   MISC / SELECTED WORK
   ============================================================ */

.sheet-misc {
  background:
    linear-gradient(rgba(51, 45, 45, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(51, 45, 45, 0.025) 1px, transparent 1px),
    var(--cream);
  background-size: 32px 32px;
}

.misc-intro {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 40px;
  padding: 28px 0 44px;
  border-bottom: 1px solid var(--line);
}

.misc-intro p {
  max-width: 650px;
  margin: 0;
  font-size: clamp(18px, 2vw, 27px);
  line-height: 1.25;
  letter-spacing: -0.03em;
}

.misc-meta {
  display: flex;
  flex-direction: column;
  gap: 5px;
  text-align: right;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.08em;
}

.misc-section {
  padding: 42px 0 0;
}

.misc-section-head {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--charcoal);
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
}

.misc-video-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  padding-top: 22px;
}

.misc-video-card,
.misc-reel-card {
  min-width: 0;
}

.misc-video-frame {
  position: relative;
  overflow: hidden;
  background: #1d1919;
  aspect-ratio: 9 / 16;
}

.misc-video-frame video {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.misc-index {
  position: absolute;
  top: 10px;
  left: 10px;
  z-index: 2;
  padding: 5px 7px;
  background: var(--cream);
  color: var(--charcoal);
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.08em;
}

.misc-card-info {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 18px;
  padding: 13px 0 20px;
  border-bottom: 1px solid var(--line);
}

.misc-card-info small {
  display: block;
  margin-bottom: 5px;
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.08em;
  opacity: 0.65;
}

.misc-card-info h3 {
  margin: 0;
  font-family: var(--sans);
  font-size: 15px;
  font-weight: 500;
  letter-spacing: -0.02em;
}

.misc-card-info > span,
.misc-card-info > a {
  flex-shrink: 0;
  color: inherit;
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.07em;
  text-decoration: none;
}

.misc-social-section {
  padding-bottom: 40px;
}

.misc-note {
  max-width: 680px;
  padding: 18px 0 24px;
  font-size: 13px;
  line-height: 1.55;
  opacity: 0.7;
}

.misc-reel-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.misc-reel-placeholder {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  aspect-ratio: 9 / 16;
  padding: 18px;
  overflow: hidden;
  background:
    radial-gradient(circle at 70% 20%, rgba(252, 249, 242, 0.18), transparent 25%),
    #332d2d;
  color: var(--cream);
}

.misc-reel-placeholder::before {
  content: "";
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(252, 249, 242, 0.3);
  pointer-events: none;
}

.misc-reel-placeholder span {
  position: relative;
  z-index: 1;
  margin-top: auto;
  margin-bottom: auto;
  font-size: clamp(26px, 3vw, 44px);
  line-height: 0.9;
  letter-spacing: -0.06em;
}

.misc-reel-placeholder small {
  position: relative;
  z-index: 1;
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.1em;
}

.misc-reel-card .misc-card-info {
  min-height: 78px;
}

.misc-reel-card .misc-card-info a {
  transition: transform 180ms ease, opacity 180ms ease;
}

.misc-reel-card .misc-card-info a:hover {
  transform: translateX(4px);
  opacity: 0.6;
}

.file-misc {
  transform: rotate(-1.2deg);
}

.file-misc:hover {
  transform: translateY(-8px) rotate(0deg);
}

@media (max-width: 900px) {
  .misc-video-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .misc-reel-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .misc-intro {
    display: block;
    padding: 22px 0 30px;
  }

  .misc-meta {
    margin-top: 18px;
    text-align: left;
  }

  .misc-section {
    padding-top: 30px;
  }

  .misc-video-grid,
  .misc-reel-grid {
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .misc-card-info {
    display: block;
  }

  .misc-card-info > span,
  .misc-card-info > a {
    display: block;
    margin-top: 10px;
  }

  .misc-card-info h3 {
    font-size: 12px;
  }

  .misc-note {
    font-size: 12px;
  }
}

@media (max-width: 420px) {
  .misc-video-grid,
  .misc-reel-grid {
    grid-template-columns: 1fr;
  }
}


/* ============================================================
   SOLETRUSTMEDIA / FINAL ARCHIVE REPAIR PASS
   Targets the current Home.tsx archive structure.
   ============================================================ */

/* ---------- 08-FILE ARCHIVE DESK ---------- */

.archive-desk::after {
  content: "ARCHIVE  /  01—08";
}

.file-misc {
  grid-column: 1 / span 3;
  grid-row: 7 / span 2;
  --rotate: -1.5deg;
  margin-top: -6px;
  min-height: 142px;
  z-index: 1;
}

.file-misc:hover {
  transform: translateY(-8px) rotate(0deg) !important;
  z-index: 20;
}

/* Keep the final invitation visually distinct from MISC. */
.file-contact {
  grid-column: 10 / span 3;
  grid-row: 6 / span 3;
}

/* MISC preview must be visible on the physical archive file. */
.file-misc .file-preview {
  right: -18px;
  top: -18px;
}

/* ---------- ARCHIVE PREVIEW SAFETY ---------- */

.file-preview {
  overflow: hidden;
}

.file-preview img {
  background: var(--paper);
}

.file-preview-editorial {
  width: 100%;
  height: 100%;
  display: grid;
  align-content: center;
  gap: 5px;
  padding: 8px;
  background:
    repeating-linear-gradient(
      -45deg,
      transparent 0 7px,
      rgba(51,45,45,.05) 8px 9px
    ),
    var(--paper);
  color: var(--charcoal);
}

.file-preview-editorial small,
.file-preview-editorial strong,
.file-preview-editorial i {
  display: block;
}

.file-preview-editorial small {
  font: 7px var(--mono);
  letter-spacing: .07em;
}

.file-preview-editorial strong {
  font: 16px/.85 var(--sans);
  letter-spacing: -.06em;
}

.file-preview-editorial i {
  font: 6px var(--mono);
  letter-spacing: .06em;
  color: var(--ink-soft);
  font-style: normal;
}

/* ---------- SIGNATURE OPENING / MISC ---------- */

.spill-misc {
  inset: 10% 12%;
  color: var(--cream);
}

.spill-misc .misc-spill-card {
  position: absolute;
  width: 190px;
  min-height: 155px;
  padding: 15px;
  border: 1px solid rgba(252,249,242,.7);
  background: rgba(51,45,45,.94);
  box-shadow: 10px 13px 0 rgba(0,0,0,.22);
}

.spill-misc .misc-spill-card:nth-child(1) {
  left: 4%;
  top: 13%;
  transform: rotate(-7deg);
}

.spill-misc .misc-spill-card:nth-child(2) {
  right: 8%;
  top: 8%;
  transform: rotate(6deg);
}

.spill-misc .misc-spill-card:nth-child(3) {
  left: 38%;
  bottom: 7%;
  transform: rotate(-2deg);
}

.spill-misc .misc-spill-card i {
  display: block;
  font: 7px var(--mono);
  letter-spacing: .08em;
  opacity: .65;
  font-style: normal;
}

.spill-misc .misc-spill-card strong {
  display: block;
  margin-top: 38px;
  font: 28px/.82 var(--sans);
  letter-spacing: -.07em;
}

.spill-misc .misc-spill-card span {
  position: absolute;
  left: 15px;
  bottom: 14px;
  font: 7px var(--mono);
  letter-spacing: .07em;
  color: rgba(252,249,242,.65);
}

/* ---------- MISC / SELECTED WORK ---------- */

.sheet-misc {
  isolation: isolate;
}

.misc-intro {
  position: relative;
}

.misc-section {
  position: relative;
}

.misc-video-card,
.misc-reel-card {
  position: relative;
}

.misc-video-frame,
.misc-reel-placeholder {
  border: 1px solid rgba(51,45,45,.18);
  box-shadow: 7px 9px 0 rgba(51,45,45,.07);
}

.misc-video-frame video {
  background: #1d1919;
  object-position: center;
}

/* Browser/video controls stay usable and audio is not visually hidden. */
.misc-video-frame video::-webkit-media-controls {
  opacity: 1;
}

.misc-index {
  pointer-events: none;
}

.misc-card-info {
  min-width: 0;
}

.misc-card-info h3 {
  overflow-wrap: anywhere;
}

.misc-reel-placeholder {
  transition:
    transform .35s var(--ease-out),
    box-shadow .35s var(--ease-out);
}

.misc-reel-card:hover .misc-reel-placeholder {
  transform: translateY(-5px);
  box-shadow: 11px 14px 0 rgba(51,45,45,.12);
}

.misc-reel-placeholder::after {
  content: "OPEN EXTERNAL REEL ↗";
  position: absolute;
  left: 18px;
  bottom: 18px;
  z-index: 2;
  padding: 6px 7px;
  background: var(--cream);
  color: var(--charcoal);
  font: 7px var(--mono);
  letter-spacing: .07em;
}

.misc-reel-placeholder span,
.misc-reel-placeholder small {
  pointer-events: none;
}

/* ---------- MOBILE ARCHIVE ---------- */

@media (max-width: 900px) {
  .archive-desk {
    min-height: 780px;
  }

  .file-misc {
    grid-column: 1 / span 4;
    grid-row: 7 / span 2;
    margin-top: 0;
  }

  .file-contact {
    grid-column: 9 / span 4;
    grid-row: 6 / span 3;
  }

  .misc-video-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .misc-reel-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .spill-misc {
    inset: 10% 6%;
  }

  .spill-misc .misc-spill-card {
    width: 150px;
    min-height: 125px;
  }
}

@media (max-width: 640px) {
  /* The archive is deliberately stacked on mobile. */
  .archive-desk {
    display: flex;
    flex-direction: column;
    gap: 19px;
    min-height: 0;
    padding: 44px 10px 76px;
  }

  .archive-file,
  .file-misc,
  .file-contact {
    width: 82%;
    min-height: 150px;
    margin: 0 !important;
  }

  .file-misc {
    align-self: flex-start;
    order: 7;
  }

  .file-contact {
    align-self: flex-end;
    order: 8;
  }

  .misc-video-grid,
  .misc-reel-grid {
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .misc-video-frame,
  .misc-reel-placeholder {
    aspect-ratio: 9 / 16;
  }

  .misc-card-info {
    padding-bottom: 16px;
  }

  .misc-card-info h3 {
    font-size: 12px;
  }

  .misc-reel-placeholder {
    padding: 12px;
  }

  .misc-reel-placeholder span {
    font-size: 25px;
  }

  .misc-reel-placeholder::after {
    left: 12px;
    bottom: 12px;
    font-size: 6px;
  }

  .spill-misc {
    inset: 8% 4%;
  }

  .spill-misc .misc-spill-card {
    width: 125px;
    min-height: 105px;
    padding: 11px;
  }

  .spill-misc .misc-spill-card:nth-child(1) {
    left: 0;
    top: 12%;
  }

  .spill-misc .misc-spill-card:nth-child(2) {
    right: 0;
    top: 7%;
  }

  .spill-misc .misc-spill-card:nth-child(3) {
    left: 29%;
    bottom: 6%;
  }

  .spill-misc .misc-spill-card strong {
    margin-top: 25px;
    font-size: 21px;
  }

  .spill-misc .misc-spill-card span {
    left: 11px;
    bottom: 10px;
    font-size: 6px;
  }
}

@media (max-width: 420px) {
  .misc-video-grid,
  .misc-reel-grid {
    grid-template-columns: 1fr;
  }

  .misc-video-frame,
  .misc-reel-placeholder {
    aspect-ratio: 9 / 13;
  }
}

/* ---------- TOUCH / ACCESSIBILITY ---------- */

@media (hover: none) {
  .archive-file:hover {
    transform: rotate(var(--rotate, 0deg));
    box-shadow: 8px 10px 0 rgba(51,45,45,.07);
  }

  .archive-file:active {
    transform: translateY(-3px) scale(.985) !important;
  }

  .misc-reel-card:hover .misc-reel-placeholder {
    transform: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .misc-reel-placeholder,
  .misc-video-frame,
  .archive-file {
    transition: none !important;
  }
}


/* ============================================================
   FINAL ARCHIVE DESK COMPOSITION
   Clean 3-row editorial layout — no overlapping files.
   ============================================================ */
@media (min-width: 901px) {
  .archive-desk {
    min-height: 860px;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(190px, 1fr));
    column-gap: 24px;
    row-gap: 34px;
    padding: 54px 12px 86px;
    align-items: stretch;
  }

  .archive-file {
    min-width: 0;
    width: auto;
    min-height: 0;
    margin: 0 !important;
  }

  /* Row 1 — primary archive */
  .file-work { grid-column: 1 / span 5; grid-row: 1; --rotate: -1.2deg; }
  .file-capabilities { grid-column: 6 / span 4; grid-row: 1; --rotate: 1.2deg; }
  .file-process { grid-column: 10 / span 3; grid-row: 1; --rotate: -1deg; }

  /* Row 2 — studio / social / concept */
  .file-about { grid-column: 1 / span 3; grid-row: 2; --rotate: -1.5deg; }
  .file-instagram { grid-column: 4 / span 3; grid-row: 2; --rotate: 1.5deg; min-height: 0; }
  .file-dbu { grid-column: 7 / span 3; grid-row: 2; --rotate: -.8deg; }
  .file-misc { grid-column: 10 / span 3; grid-row: 2; --rotate: 1.2deg; min-height: 0; }

  /* Row 3 — invitation */
  .file-contact { grid-column: 5 / span 4; grid-row: 3; --rotate: -1deg; }

  .file-preview { z-index: 2; }
  .file-work .file-preview,
  .file-capabilities .file-preview,
  .file-process .file-preview {
    max-height: 88px;
  }
}

/* Audio is intentionally never muted by the portfolio UI. */
.misc-video-frame video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
