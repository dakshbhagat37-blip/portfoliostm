@import "tailwindcss";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

:root {
  --cream: #fcf9f2;
  --paper: #f4eee3;
  --charcoal: #332d2d;
  --ink-soft: #675e59;
  --line: rgba(51, 45, 45, 0.18);
  --line-dark: rgba(252, 249, 242, 0.24);
  --acid: var(--cream);
  --serif: "DM Serif Display", Georgia, serif;
  --sans: "Space Grotesk", Arial, sans-serif;
  --mono: "DM Mono", monospace;
  --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
}

@theme inline {
  --color-background: var(--cream);
  --color-foreground: var(--charcoal);
  --color-border: var(--line);
  --font-sans: var(--sans);
}

* { box-sizing: border-box; }
html { background: var(--cream); scroll-behavior: smooth; }
body { margin: 0; background: var(--cream); color: var(--charcoal); font-family: var(--sans); font-weight: 400; -webkit-font-smoothing: antialiased; }
button, input, textarea, select { font: inherit; }
button { color: inherit; }
button:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 2px solid var(--charcoal); outline-offset: 4px; }
a { color: inherit; text-decoration: none; }

.archive-site { min-height: 100vh; overflow: hidden; position: relative; background: var(--cream); }
.grain { position: fixed; inset: 0; opacity: .065; pointer-events: none; z-index: 20; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E"); mix-blend-mode: multiply; }
.container { width: min(100% - 48px, 1400px); margin-inline: auto; }
.topbar { position: relative; z-index: 5; width: min(100% - 48px, 1400px); margin: 0 auto; padding: 27px 0; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
.brand-lockup { border: 0; background: none; padding: 0; display: inline-flex; align-items: center; gap: 12px; font-family: var(--mono); font-size: 11px; letter-spacing: .04em; cursor: pointer; }
.brand-mark { width: 28px; height: 28px; display: grid; place-items: center; background: var(--charcoal); color: var(--cream); font-family: var(--sans); font-weight: 700; font-size: 12px; letter-spacing: -.08em; }
.brand-mark span { color: var(--acid); }
.topbar-right { display: flex; align-items: center; gap: 28px; font: 10px var(--mono); letter-spacing: .08em; color: var(--ink-soft); }
.archive-status { color: var(--charcoal); display: flex; align-items: center; gap: 7px; }
.archive-status i { width: 6px; height: 6px; border-radius: 50%; background: var(--charcoal); display: block; box-shadow: 0 0 0 3px rgba(51,45,45,.12); }

.hero { min-height: min(640px, calc(100vh - 76px)); position: relative; display: grid; grid-template-columns: 1fr minmax(520px, 1.75fr) 160px; align-items: center; padding: 80px 0 120px; }
.hero-kicker { align-self: start; padding-top: 18px; display: flex; flex-direction: column; gap: 10px; font: 10px var(--mono); color: var(--ink-soft); letter-spacing: .08em; line-height: 1.5; }
.hero-kicker span:last-child { color: var(--charcoal); }
.hero-copy { position: relative; z-index: 1; }
.hero-overline, .section-label, .sheet-eyebrow { margin: 0 0 20px; font: 10px var(--mono); letter-spacing: .08em; color: var(--ink-soft); }
.hero-copy h1 { margin: 0; font-size: clamp(58px, 9.4vw, 154px); line-height: .83; letter-spacing: -.075em; font-weight: 500; animation: heroIn .9s var(--ease-out) both; }
.hero-copy h1 em, .archive-heading h2 em, .sheet h2 em, .contact-copy em, .dbu-hero em { font-family: var(--serif); font-weight: 400; letter-spacing: -.06em; }
.hero-side-note { align-self: end; display: flex; flex-direction: column; justify-content: space-between; height: 130px; font: 10px var(--mono); letter-spacing: .08em; color: var(--ink-soft); line-height: 1.4; }
.hero-arrow { font-size: 28px; color: var(--charcoal); }

.archive-section { padding-bottom: 96px; }
.archive-heading { display: flex; align-items: end; justify-content: space-between; padding: 0 0 28px; border-bottom: 1px solid var(--line); }
.archive-heading h2 { margin: 0; font-size: clamp(34px, 4.1vw, 60px); line-height: .9; letter-spacing: -.06em; font-weight: 500; }
.archive-description { max-width: 250px; margin: 0 4% 1px 0; font-size: 13px; line-height: 1.45; color: var(--ink-soft); }
.archive-desk { min-height: 650px; position: relative; display: grid; grid-template-columns: repeat(12, 1fr); grid-template-rows: repeat(8, 1fr); padding: 58px 0 70px; }
.archive-desk::before { content: ""; position: absolute; inset: 28px 0 34px; border: 1px solid rgba(51,45,45,.09); transform: rotate(-.4deg); pointer-events: none; }
.archive-desk::after { content: "ARCHIVE  /  01—07"; position: absolute; right: 0; bottom: 44px; font: 10px var(--mono); color: var(--ink-soft); letter-spacing: .1em; }
.desk-caption { position: absolute; left: 0; bottom: 44px; display: flex; gap: 30px; font: 10px var(--mono); color: var(--ink-soft); letter-spacing: .08em; }
.archive-file { --file-bg: var(--paper); --file-fg: var(--charcoal); position: relative; isolation: isolate; padding: 20px 20px 17px; border: 1px solid rgba(51,45,45,.28); background: var(--file-bg); color: var(--file-fg); text-align: left; display: flex; flex-direction: column; justify-content: space-between; min-height: 164px; box-shadow: 8px 10px 0 rgba(51,45,45,.07); transform: rotate(var(--rotate, 0deg)); transition: transform .35s var(--ease-out), box-shadow .35s var(--ease-out), background .35s var(--ease-out), color .35s var(--ease-out); cursor: pointer; opacity: 0; animation: objectIn .7s var(--ease-out) forwards; }
.archive-file:hover { transform: translateY(-8px) rotate(0deg) !important; box-shadow: 14px 18px 0 rgba(51,45,45,.12); z-index: 3; }
.archive-file:active { transform: translateY(-3px) scale(.985) !important; }
.archive-file::after { content: ""; position: absolute; inset: 5px; border: 1px solid currentColor; opacity: .1; pointer-events: none; }
.file-pin { position: absolute; width: 8px; height: 8px; border-radius: 50%; top: 13px; right: 14px; background: currentColor; opacity: .65; }
.file-topline, .file-bottomline { display: flex; justify-content: space-between; font: 9px var(--mono); letter-spacing: .05em; opacity: .72; }
.file-title { display: block; margin: 28px 0 6px; font-size: clamp(18px, 2vw, 28px); font-weight: 600; letter-spacing: -.07em; line-height: .9; }
.file-detail { font: 9px var(--mono); letter-spacing: .06em; opacity: .72; }
.file-rule { display: block; height: 1px; background: currentColor; opacity: .22; margin: 22px 0 11px; }
.tone-charcoal { --file-bg: var(--charcoal); --file-fg: var(--cream); border-color: var(--charcoal); box-shadow: 8px 10px 0 rgba(51,45,45,.22); }
.tone-outline { --file-bg: transparent; --file-fg: var(--charcoal); box-shadow: none; }
.file-work { grid-column: 1 / span 4; grid-row: 1 / span 3; --rotate: -2deg; }
.file-capabilities { grid-column: 6 / span 4; grid-row: 1 / span 3; --rotate: 2deg; margin-top: 8px; }
.file-process { grid-column: 10 / span 3; grid-row: 2 / span 3; --rotate: -3deg; margin-left: 8px; }
.file-instagram { grid-column: 3 / span 3; grid-row: 5 / span 3; --rotate: 3deg; margin-top: -12px; }
.file-dbu { grid-column: 6 / span 4; grid-row: 5 / span 3; --rotate: -1deg; margin-top: -8px; }.file-instagram .file-title { font-family: var(--serif); font-style: italic; font-weight: 400; }
.file-about { grid-column: 1 / span 3; grid-row: 5 / span 2; --rotate: -4deg; margin-top: 14px; min-height: 130px; }.file-instagram { min-height: 185px; }
.file-contact { grid-column: 10 / span 3; grid-row: 6 / span 3; --rotate: 2.5deg; margin-top: -15px; }

.footer { padding: 24px 0 30px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; font: 10px var(--mono); letter-spacing: .07em; color: var(--ink-soft); }
.footer a { color: var(--charcoal); }

.cursor-tag { position: fixed; z-index: 100; display: flex; align-items: center; gap: 5px; background: var(--charcoal); color: var(--cream); padding: 7px 9px; font: 9px var(--mono); letter-spacing: .08em; opacity: 0; transform: translateY(5px); pointer-events: none; transition: opacity .18s ease, transform .18s ease; }
.cursor-tag.is-visible { opacity: 1; transform: translateY(0); }

.sheet-backdrop { position: fixed; inset: 0; z-index: 50; padding: clamp(14px, 3vw, 42px); background: rgba(51,45,45,.76); display: grid; place-items: center; animation: backdropIn .32s ease both; overflow-y: auto; }
.backdrop-dark { background: var(--charcoal); }
.sheet { width: min(1180px, 100%); max-height: min(900px, calc(100vh - 28px)); overflow: auto; position: relative; background: var(--cream); color: var(--charcoal); padding: clamp(24px, 4vw, 54px); box-shadow: 18px 22px 0 rgba(0,0,0,.2); animation: sheetIn .52s var(--ease-out) both; }
.sheet::-webkit-scrollbar { width: 6px; }.sheet::-webkit-scrollbar-thumb { background: var(--charcoal); }
.sheet-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
.sheet-header h2 { margin: 0; font-size: clamp(37px, 5vw, 77px); font-weight: 500; line-height: .84; letter-spacing: -.075em; }
.close-button { flex: none; border: 0; background: transparent; display: flex; align-items: center; gap: 7px; padding: 5px 0; font: 10px var(--mono); letter-spacing: .08em; cursor: pointer; transition: transform .2s var(--ease-out); }.close-button:hover { transform: translateX(-4px); }
.sheet-lede { max-width: 390px; color: var(--ink-soft); font-size: 14px; line-height: 1.45; }
.work-intro { display: flex; justify-content: space-between; align-items: end; gap: 20px; padding: 25px 0 18px; }.work-count, .reveal-index, .sheet-footnote { font: 10px var(--mono); letter-spacing: .08em; color: var(--ink-soft); }
.project-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
.project-card { padding: 0; border: 0; background: transparent; text-align: left; cursor: pointer; transition: transform .3s var(--ease-out); }.project-card:hover { transform: translateY(-7px); }.project-card:hover .project-open { opacity: 1; transform: translateY(0); }
.project-image-wrap { position: relative; overflow: hidden; background: var(--paper); aspect-ratio: .83; }.project-image-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(.78); transition: transform .5s var(--ease-out), filter .5s var(--ease-out); }.project-card:hover img { transform: scale(1.045); filter: saturate(1); }.project-open { position: absolute; left: 12px; bottom: 12px; display: flex; align-items: center; gap: 5px; padding: 7px 8px; background: var(--cream); font: 9px var(--mono); opacity: 0; transform: translateY(5px); transition: opacity .25s, transform .25s var(--ease-out); }.project-meta { display: flex; justify-content: space-between; gap: 12px; padding: 11px 0 8px; font: 8px var(--mono); color: var(--ink-soft); letter-spacing: .04em; }.project-card h3 { margin: 0; font-size: 21px; letter-spacing: -.06em; font-weight: 600; }.project-card p { margin: 5px 0 0; font-size: 11px; color: var(--ink-soft); line-height: 1.35; }.sheet-footnote { display: flex; justify-content: space-between; padding-top: 28px; margin-top: 32px; border-top: 1px solid var(--line); }

.project-detail-head { display: flex; justify-content: space-between; gap: 24px; padding: 22px 0 24px; font: 10px var(--mono); letter-spacing: .07em; }.project-detail-head p { margin: 0; }.project-detail-head p:last-child { max-width: 320px; color: var(--ink-soft); font: 14px/1.4 var(--sans); letter-spacing: 0; }.project-mosaic { display: grid; grid-template-columns: 1.2fr .8fr; grid-template-rows: 290px 170px; gap: 14px; }.mosaic-image { overflow: hidden; background: var(--paper); }.mosaic-image img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(.8); }.mosaic-large { grid-row: span 2; }.mosaic-small img { object-position: center 40%; }.mosaic-note { background: var(--charcoal); color: var(--cream); padding: 20px; display: flex; flex-direction: column; justify-content: space-between; }.mosaic-note span, .project-services > span { font: 9px var(--mono); letter-spacing: .08em; opacity: .7; }.mosaic-note p { font-size: clamp(18px, 2.2vw, 28px); line-height: .98; letter-spacing: -.055em; max-width: 290px; margin: 0; }.project-services { display: flex; gap: 24px; padding-top: 22px; }.project-services > div { display: flex; flex-wrap: wrap; gap: 8px; }.project-services > div span { border: 1px solid var(--line); padding: 7px 9px; font: 10px var(--mono); }

.capability-layout { display: grid; grid-template-columns: .75fr 1.25fr; gap: 60px; padding-top: 42px; }.capability-list { border-top: 1px solid var(--line); }.capability-tab { width: 100%; border: 0; border-bottom: 1px solid var(--line); background: transparent; padding: 19px 0; display: grid; grid-template-columns: 46px 1fr auto; align-items: center; text-align: left; cursor: pointer; color: var(--ink-soft); transition: color .25s, padding .25s var(--ease-out); }.capability-tab span { font: 10px var(--mono); }.capability-tab strong { font-size: clamp(20px, 3vw, 34px); letter-spacing: -.07em; font-weight: 500; }.capability-tab:hover, .capability-tab.is-active { color: var(--charcoal); padding-left: 10px; }.capability-reveal { min-height: 380px; background: var(--paper); padding: 28px; position: relative; }.capability-reveal::before { content: ""; position: absolute; inset: 9px; border: 1px solid rgba(51,45,45,.12); pointer-events: none; }.capability-reveal h3 { margin: 65px 0 30px; font-size: clamp(45px, 7vw, 94px); line-height: .8; letter-spacing: -.085em; font-weight: 500; }.capability-items { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); }.capability-items div { padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 13px; }.capability-items span { margin-right: 10px; color: var(--ink-soft); font: 9px var(--mono); }.capability-reveal > p { max-width: 220px; position: absolute; right: 28px; bottom: 28px; margin: 0; color: var(--ink-soft); font-size: 11px; line-height: 1.35; }

.process-lede { margin: 28px 0 34px; }.process-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); }.process-step { min-height: 140px; padding: 20px 16px 20px 0; display: grid; grid-template-columns: 44px 1fr 20px; gap: 12px; border-bottom: 1px solid var(--line); }.process-step:nth-child(odd) { border-right: 1px solid var(--line); padding-right: 24px; }.process-step:nth-child(even) { padding-left: 24px; }.process-number { font: 10px var(--mono); color: var(--ink-soft); }.process-step h3 { margin: 0 0 8px; font-size: clamp(24px, 3vw, 41px); line-height: .9; letter-spacing: -.07em; font-weight: 500; }.process-step p { margin: 0; max-width: 250px; color: var(--ink-soft); font-size: 12px; line-height: 1.35; }.process-arrow { font-size: 18px; }

.sheet-manifesto { min-height: min(780px, calc(100vh - 28px)); background: var(--charcoal); color: var(--cream); display: flex; flex-direction: column; justify-content: space-between; box-shadow: none; }.manifesto-top, .manifesto-bottom { display: flex; align-items: center; justify-content: space-between; font: 10px var(--mono); letter-spacing: .08em; color: rgba(252,249,242,.62); }.close-button-dark { color: var(--cream); }.manifesto-copy { padding: 70px 0; }.manifesto-copy > p { margin: 0 0 38px; font: 10px var(--mono); letter-spacing: .08em; color: var(--acid); }.manifesto-copy h2 { margin: 0; font: 500 clamp(44px, 8vw, 112px)/.82 var(--sans); letter-spacing: -.09em; }.manifesto-copy h2 + h2 { margin-top: 54px; text-align: right; }.manifesto-copy em { color: var(--acid); font: 400 .98em/.7 var(--serif); }.manifesto-bottom button { border: 0; background: transparent; color: var(--cream); display: flex; align-items: center; gap: 7px; padding: 0; font: 10px var(--mono); letter-spacing: .08em; cursor: pointer; }

.dbu-hero { padding: 46px 0 38px; border-bottom: 1px solid var(--line); }.dbu-hero p { margin: 0 0 16px; font: 10px var(--mono); letter-spacing: .08em; }.dbu-hero h3 { margin: 0; font-size: clamp(41px, 6vw, 82px); line-height: .85; letter-spacing: -.08em; font-weight: 500; }.dbu-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; padding: 24px 0 50px; }.dbu-card { min-height: 112px; padding: 13px; border: 1px solid var(--line); display: flex; flex-direction: column; justify-content: space-between; transition: background .25s, color .25s, transform .25s var(--ease-out); }.dbu-card:hover { background: var(--charcoal); color: var(--cream); transform: translateY(-4px); }.dbu-card span, .dbu-card svg { opacity: .6; }.dbu-card span { font: 9px var(--mono); }.dbu-card strong { font-size: 14px; line-height: .95; letter-spacing: -.04em; }.dbu-card svg { align-self: end; }.funnel-wrap { display: grid; grid-template-columns: .8fr 2.2fr; gap: 40px; padding: 25px 0 0; border-top: 1px solid var(--line); }.funnel-label { font-size: clamp(26px, 4vw, 48px); font-weight: 500; line-height: .88; letter-spacing: -.075em; }.funnel-line { display: flex; align-items: center; justify-content: space-between; gap: 6px; }.funnel-line > div { display: flex; flex-direction: column; gap: 8px; min-width: 0; }.funnel-line span { font: 9px var(--mono); color: var(--ink-soft); }.funnel-line strong { font-size: 10px; line-height: 1; max-width: 88px; }.funnel-line svg { color: var(--ink-soft); margin-top: 10px; }

.about-copy { display: grid; grid-template-columns: .7fr 1.3fr; gap: 40px; padding: 80px 0 50px; }.about-mark { font-size: clamp(80px, 16vw, 220px); line-height: .7; letter-spacing: -.13em; font-weight: 700; }.about-mark span { color: var(--acid); font-size: .36em; vertical-align: top; }.about-lede { margin: 0 0 58px; max-width: 450px; font-size: clamp(24px, 3.1vw, 46px); line-height: .98; letter-spacing: -.065em; }.about-stack { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 13px; font: 11px var(--mono); letter-spacing: .07em; }.about-stack b { font-size: 18px; font-weight: 400; color: var(--ink-soft); }.about-copy strong { display: block; margin-top: 34px; font-size: clamp(25px, 3vw, 42px); line-height: .9; letter-spacing: -.07em; }

.contact-layout { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(40px, 8vw, 120px); padding-top: 56px; }.contact-copy > p { margin: 0 0 18px; font: 10px var(--mono); letter-spacing: .08em; }.contact-copy h3 { margin: 0; font-size: clamp(47px, 7vw, 92px); line-height: .82; letter-spacing: -.085em; font-weight: 500; }.contact-copy a { display: inline-flex; align-items: center; gap: 8px; margin-top: 90px; font: 11px var(--mono); letter-spacing: .03em; border-bottom: 1px solid var(--charcoal); padding-bottom: 7px; }.contact-form { display: flex; flex-direction: column; gap: 18px; }.contact-form label { display: flex; flex-direction: column; gap: 7px; font: 10px var(--mono); letter-spacing: .08em; }.contact-form input, .contact-form textarea, .contact-form select { border: 0; border-bottom: 1px solid var(--line); border-radius: 0; background: transparent; color: var(--charcoal); padding: 8px 0 11px; outline: none; resize: vertical; font: 14px var(--sans); letter-spacing: 0; }.contact-form input::placeholder, .contact-form textarea::placeholder { color: #a49a91; }.contact-form input:focus, .contact-form textarea:focus, .contact-form select:focus { border-color: var(--charcoal); }.submit-button { align-self: flex-start; border: 1px solid var(--charcoal); background: var(--charcoal); color: var(--cream); padding: 14px 16px; margin-top: 10px; font: 10px var(--mono); letter-spacing: .08em; cursor: pointer; transition: background .25s, color .25s; }.submit-button:hover { background: transparent; color: var(--charcoal); }.form-note { margin: -6px 0 0; color: var(--ink-soft); font-size: 11px; line-height: 1.35; }


/* Revised visual sheets */
.sheet-instagram { background: #f0e8dc; }
