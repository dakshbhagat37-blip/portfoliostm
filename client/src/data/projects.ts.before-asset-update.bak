export type InstagramReel = {
  id: string;
  thumbnail: string;
  url: string;
  label?: string;
};

export type Project = {
  id?: string;
  category?: string;
  status?: string;
  year?: string;
  clientStatus?: string;
  role?: string;

  name: string;
  type: string;
  note: string;
  description: string;
  services: string[];
  images: string[];
  marker: string;

  tag:
    | "CLIENT WORK"
    | "SELF-INITIATED CONCEPT"
    | "SOURCE ASSET PENDING";

  cta?: "OPEN WEBSITE" | "OPEN CONCEPT" | "VIEW PROJECT";

  url?: string;
  website?: string;

  tags: string[];
  featured?: boolean;

  /*
   * Optional Instagram Reel gallery.
   * Used mainly for STM MUSIC GROUP.
   */
  instagramReels?: InstagramReel[];
};

