export const projects: Project[] = rawProjects.map(
  (project) => {
    const metadata =
      projectMetadata[project.name] ?? {
        tags: [],
      };

    const id = project.name
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");

    const isClient =
      project.tag === "CLIENT WORK";

    return {
      ...project,
      ...metadata,

      id,

      category:
        project.type.split(" /")[0],

      status:
        project.tag,

      year:
        "2026",

      clientStatus:
        isClient
          ? "CLIENT WORK"
          : "CONCEPT / EXPERIMENT",

      role:
        "CREATIVE + DIGITAL SYSTEMS",
    };
  }
);
